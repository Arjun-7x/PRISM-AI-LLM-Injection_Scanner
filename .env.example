# Copy this file to .env and fill in ONE of the two keys below, then
# `export $(cat .env | xargs)` before running server.py — or just export
# the variable directly in your shell. Never commit a real .env file;
# it's already covered by .gitignore.

# Preferred — fast, generous free tier
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Fallback if GROQ_API_KEY is not set
ANTHROPIC_API_KEY=sk-ant-your_key_here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Only set this to true if the app is deployed behind a reverse proxy
# (nginx, a load balancer) that sets/overwrites X-Forwarded-For itself.
TRUST_X_FORWARDED_FOR=false
